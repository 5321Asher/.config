/* Generated from the Deep Field theme by ~/.config/theme/theme */
/* Observatory: brass instruments on a night sky */
QMainWindow, QDialog {
  background-color: #0b0e17;
  background-image: url(/home/av/.cache/theme/style/observatory/stardust-abf6561366.png);
}
QPushButton, QComboBox {
  background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #141a28, stop:1 #07090f);
  color: #d8d2c2;
  border: 1px solid rgba(201, 164, 92, 0.4);
  border-radius: 6px;
  padding: 5px 12px;
}
QPushButton:hover, QComboBox:hover { border-color: #c9a45c; color: #ecd092; }
QPushButton:pressed, QPushButton:checked {
  background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #5e4d2c, stop:1 #322b1e);
  border-color: #ecd092;
  color: #f3efe4;
}
QPushButton:default {
  background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #ecd092, stop:1 #c9a45c);
  color: #07090f;
  border-color: #ecd092;
  font-weight: 600;
}
QPushButton:disabled, QComboBox:disabled { color: #5d6679; background-color: #0b0e17; border-color: #2a3246; }
QToolButton { background: transparent; border: 1px solid transparent; border-radius: 6px; padding: 3px; }
QToolButton:hover { background-color: rgba(201, 164, 92, 0.12); border-color: rgba(201, 164, 92, 0.5); }
QToolButton:pressed, QToolButton:checked { background-color: rgba(201, 164, 92, 0.22); border-color: #ecd092; }

QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox {
  background-color: #07090f;
  color: #d8d2c2;
  border: 1px solid rgba(201, 164, 92, 0.28);
  border-radius: 6px;
  padding: 4px 8px;
  selection-background-color: rgba(111, 214, 208, 0.3);
  selection-color: #f3efe4;
}
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
  border-color: #c9a45c;
}
QComboBox::drop-down { border: none; width: 22px; }
QComboBox QAbstractItemView {
  background-color: #07090f; color: #d8d2c2; border: 1px solid rgba(201, 164, 92, 0.6);
  border-radius: 6px; selection-background-color: rgba(201, 164, 92, 0.22); outline: 0; padding: 4px;
}

QMenuBar { background-color: #07090f; border-bottom: 1px solid rgba(201, 164, 92, 0.3); }
QMenuBar::item { background: transparent; padding: 4px 10px; border-radius: 4px; }
QMenuBar::item:selected { color: #ecd092; background-color: rgba(201, 164, 92, 0.12); }
QMenu {
  background-color: #07090f; color: #d8d2c2;
  border: 1px solid rgba(201, 164, 92, 0.6); border-radius: 8px; padding: 5px;
}
QMenu::item { padding: 6px 22px 6px 12px; border-radius: 4px; }
QMenu::item:selected { background-color: rgba(201, 164, 92, 0.2); color: #ecd092; }
QMenu::item:disabled { color: #5d6679; }
QMenu::separator { height: 1px; background: rgba(201, 164, 92, 0.2); margin: 4px 8px; }

QToolTip {
  background-color: #07090f; color: #d8d2c2;
  border: 1px solid #c9a45c; border-radius: 6px; padding: 5px 8px;
}

QTabWidget::pane { border: 1px solid rgba(201, 164, 92, 0.3); border-radius: 6px; top: -1px; background: #0b0e17; }
QTabBar::tab {
  background: #07090f; color: #5d6679;
  border: 1px solid rgba(201, 164, 92, 0.25); border-bottom: none;
  border-top-left-radius: 6px; border-top-right-radius: 6px;
  padding: 6px 16px; margin-right: 2px;
}
QTabBar::tab:hover { color: #d8d2c2; }
QTabBar::tab:selected { background: #0b0e17; color: #ecd092; border-color: rgba(201, 164, 92, 0.7); border-bottom: 2px solid #ecd092; }

QHeaderView::section {
  background-color: #0b0e17; color: #c9a45c; border: none;
  border-right: 1px solid rgba(201, 164, 92, 0.15); border-bottom: 1px solid rgba(201, 164, 92, 0.4);
  padding: 5px 8px; font-weight: 600;
}
QAbstractItemView {
  background-color: #07090f; alternate-background-color: #090c13;
  outline: 0; border-radius: 6px;
}
QAbstractItemView::item { border-radius: 3px; padding: 2px; }
QAbstractItemView::item:hover { background: rgba(201, 164, 92, 0.1); }
QAbstractItemView::item:selected { background: rgba(111, 214, 208, 0.22); color: #f3efe4; }
QGroupBox { border: 1px solid rgba(201, 164, 92, 0.3); border-radius: 6px; margin-top: 14px; padding-top: 8px; }
QGroupBox::title { subcontrol-origin: margin; left: 10px; padding: 0 6px; color: #ecd092; }

QScrollBar:vertical { background: transparent; width: 9px; margin: 2px; }
QScrollBar:horizontal { background: transparent; height: 9px; margin: 2px; }
QScrollBar::handle { background: rgba(201, 164, 92, 0.35); border-radius: 4px; min-height: 24px; min-width: 24px; }
QScrollBar::handle:hover { background: #c9a45c; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; border: none; }
QScrollBar::add-page, QScrollBar::sub-page { background: none; }

QCheckBox::indicator, QRadioButton::indicator {
  width: 14px; height: 14px; background: #07090f; border: 1px solid rgba(201, 164, 92, 0.55);
}
QCheckBox::indicator { border-radius: 4px; }
QRadioButton::indicator { border-radius: 8px; }
QCheckBox::indicator:checked, QRadioButton::indicator:checked {
  background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #ecd092, stop:1 #c9a45c); border-color: #ecd092;
}

QProgressBar {
  background: #07090f; border: 1px solid rgba(201, 164, 92, 0.3); border-radius: 6px;
  text-align: center; color: #f3efe4; height: 12px;
}
QProgressBar::chunk { background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #6fd6d0, stop:1 #c9a45c); border-radius: 5px; }
QSlider::groove:horizontal { background: #07090f; height: 4px; border-radius: 2px; border: 1px solid rgba(201, 164, 92, 0.25); }
QSlider::sub-page:horizontal { background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #6fd6d0, stop:1 #c9a45c); border-radius: 2px; }
QSlider::handle:horizontal {
  background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #ecd092, stop:1 #c9a45c);
  border: 1px solid #07090f; width: 14px; margin: -6px 0; border-radius: 7px;
}
QStatusBar { background: #07090f; color: #5d6679; border-top: 1px solid rgba(201, 164, 92, 0.25); }
QSplitter::handle { background: rgba(201, 164, 92, 0.2); }
