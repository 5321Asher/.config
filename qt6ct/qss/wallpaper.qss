/* Generated from the Deep Field theme by ~/.config/theme/theme */
/* Flat and sharp like the Quickshell bar; the palette does the rest */
QPushButton, QComboBox, QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox {
  border: 1px solid #2a3246;
  border-radius: 0;
  padding: 4px 8px;
}
/* Toolbar buttons keep the style's own sizing, or their labels get elided */
QToolButton { border: 1px solid transparent; border-radius: 0; padding: 2px; }
QPushButton, QComboBox { background: #141a28; color: #d8d2c2; }
QPushButton:hover, QToolButton:hover, QComboBox:hover { background: #1d2536; }
QPushButton:pressed, QPushButton:checked, QToolButton:pressed, QToolButton:checked {
  background: #1d2536; color: #c9a45c; border-color: #c9a45c;
}
QPushButton:default { border-color: #c9a45c; }
QPushButton:disabled, QComboBox:disabled { color: #5d6679; background: #0b0e17; }
QToolButton { background: transparent; }
QToolButton:hover { border-color: #2a3246; }
QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox { background: #07090f; color: #d8d2c2; }
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
  border-color: #c9a45c;
}
QComboBox::drop-down { border: none; width: 20px; }
QComboBox QAbstractItemView {
  background: #141a28; color: #d8d2c2; border: 1px solid #2a3246;
  selection-background-color: #5e4d2c; outline: 0;
}

QMenuBar { background: #0b0e17; border-bottom: 1px solid #2a3246; }
QMenuBar::item { background: transparent; padding: 4px 10px; }
QMenuBar::item:selected { color: #c9a45c; border-bottom: 2px solid #c9a45c; }
QMenu { background: #141a28; color: #d8d2c2; border: 1px solid #2a3246; padding: 4px 0; }
QMenu::item { padding: 5px 20px 5px 10px; }
QMenu::item:selected { background: #5e4d2c; }
QMenu::item:disabled { color: #5d6679; }
QMenu::separator { height: 1px; background: #2a3246; margin: 4px 0; }

QToolTip { background: #07090f; color: #d8d2c2; border: 1px solid #c9a45c; padding: 4px; }

QTabWidget::pane { border: 1px solid #2a3246; top: -1px; }
QTabBar::tab {
  background: #07090f; color: #5d6679; border: 1px solid #2a3246;
  padding: 6px 14px; margin-right: -1px;
}
QTabBar::tab:hover { color: #d8d2c2; }
QTabBar::tab:selected { background: #141a28; color: #c9a45c; border-bottom: 2px solid #c9a45c; }

QHeaderView::section {
  background: #0b0e17; color: #5d6679; border: none;
  border-right: 1px solid #2a3246; border-bottom: 1px solid #2a3246; padding: 4px 6px;
}
QAbstractItemView { background: #07090f; alternate-background-color: #0b0e17; outline: 0; }
QAbstractItemView::item:hover { background: #1d2536; }
QAbstractItemView::item:selected { background: #5e4d2c; color: #d8d2c2; }
QGroupBox { border: 1px solid #2a3246; margin-top: 12px; padding-top: 6px; }
QGroupBox::title { subcontrol-origin: margin; left: 8px; padding: 0 4px; color: #c9a45c; }

QScrollBar:vertical { background: transparent; width: 8px; margin: 0; }
QScrollBar:horizontal { background: transparent; height: 8px; margin: 0; }
QScrollBar::handle { background: #5d6679; min-height: 24px; min-width: 24px; }
QScrollBar::handle:hover { background: #c9a45c; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; border: none; }
QScrollBar::add-page, QScrollBar::sub-page { background: none; }

QProgressBar { background: #141a28; border: none; text-align: center; color: #d8d2c2; }
QProgressBar::chunk { background: #c9a45c; }
QSlider::groove:horizontal { background: #141a28; height: 4px; }
QSlider::sub-page:horizontal { background: #c9a45c; }
QSlider::handle:horizontal { background: #d8d2c2; width: 10px; margin: -6px 0; }
QStatusBar { background: #0b0e17; color: #5d6679; border-top: 1px solid #2a3246; }
QSplitter::handle { background: #2a3246; }
