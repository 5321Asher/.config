## CAVA (Grimoire): the music as a row of candle flames, from ember at the bass to gold and a violet
## glow at the treble. Colours are fixed to Oxblood's; Grimoire's own spectrum (the Minstrelsy page)
## follows the theme.

[general]
framerate = 60
bars = 0
bar_width = 2
bar_spacing = 1

[output]
method = noncurses
orientation = bottom
channels = stereo

[color]
gradient = 1
gradient_count = 6
gradient_color_1 = '#6e2a1c'
gradient_color_2 = '#a8452a'
gradient_color_3 = '#d9803a'
gradient_color_4 = '#c9a24a'
gradient_color_5 = '#f2d98c'
gradient_color_6 = '#9b7fe0'

[smoothing]
noise_reduction = 77
monstercat = 1
waves = 0
