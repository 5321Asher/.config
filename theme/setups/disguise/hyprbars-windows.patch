+    // Disguise: dragging a maximised window's title bar restores it first (Windows): out of maximised
+    // (Hyprland's, or Disguise's own: a floating window tagged disguise-max by caption.sh), floating at
+    // the size it had before (caption.sh remembers it) or 70 % of the screen, with the pointer where it
+    // grabbed across the title bar
+    const auto PWINDOW = m_pWindow.lock();
+    const bool TAGGED  = PWINDOW && PWINDOW->m_ruleApplicator->m_tagKeeper.isTagged("disguise-max", true);
+    if (PWINDOW && (TAGGED || Fullscreen::controller()->isFullscreen(PWINDOW))) {
+        const auto MON = PWINDOW->m_monitor.lock();
+        const auto P   = g_pInputManager->getMouseCoordsInternal();
+        const auto SHARE = MON && MON->m_size.x > 0 ? (P.x - MON->m_position.x) / MON->m_size.x : 0.5;
+        const auto ADDR  = std::format("0x{:x}", (uintptr_t)PWINDOW.get());
+        if (TAGGED)
+            g_pKeybindManager->m_dispatchers["exec"](std::format("hyprctl dispatch 'hl.dsp.window.tag({{ tag = \"-disguise-max\", window = \"address:{}\" }})'", ADDR));
+        else
+            (void)Config::Actions::fullscreenWindow(Fullscreen::FSMODE_NONE, false, PWINDOW);
+        (void)Config::Actions::floatWindow(Config::Actions::eTogglableAction::TOGGLE_ACTION_ENABLE, PWINDOW);
+        if (MON) {
+            Vector2D SIZE = {std::floor(MON->m_size.x * 0.7), std::floor(MON->m_size.y * 0.7)};
+            const char* RUNTIME = getenv("XDG_RUNTIME_DIR");
+            std::ifstream saved(std::string(RUNTIME ? RUNTIME : "/tmp") + "/disguise-caption/" + ADDR);
+            double sx = 0, sy = 0, sw = 0, sh = 0;
+            if (saved >> sx >> sy >> sw >> sh && sw > 100 && sh > 100)
+                SIZE = {sw, sh};
+            (void)Config::Actions::resize(SIZE, false, PWINDOW);
+            (void)Config::Actions::move({std::floor(P.x - SIZE.x * SHARE), std::floor(P.y - 16)}, false, PWINDOW);
+        }
+    }
     g_pKeybindManager->changeMouseBindMode(MBIND_MOVE);
     m_bDraggingThis = true;
