// Template for ~/.config/fastfetch/config.jsonc, rendered by ~/.config/theme/theme on every theme
// switch. Edit this file, not config.jsonc. {{role}} = the theme colour as "r;g;b" (accent = brass,
// purple = phosphor, dim, fg, warn, danger, and Observatory's own brassBright, phosphor, starlight…);
// {{logo_*}} = the theme's fastfetch image, sized to fit settings.toml [fastfetch].
// Observatory: an observatory log. Vessel, bridge, instruments, comms, and tonight's sky.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "kitty",
    "source": "{{logo_source}}",
    "width": {{logo_width}},
    "height": {{logo_height}},
    "padding": { "top": 1, "left": 2, "right": 4 }
  },
  "display": {
    "separator": "  ",
    "key": { "width": 15 },
    "color": {
      "separator": "38;2;{{dim}}",
      "output": "38;2;{{fg}}"
    }
  },
  "modules": [
    { "type": "custom", "format": "{#38;2;{{brassBright}}}◈  O B S E R V A T O R Y   L O G" },
    {
      "type": "command",
      "key": "   stardate",
      "keyColor": "38;2;{{dim}}",
      "text": "printf '%s.%03d  ·  %s@%s' \"$(date +%Y)\" \"$(date +%j)\" \"$USER\" \"$(cat /etc/hostname 2>/dev/null || uname -n)\""
    },
    "break",

    { "type": "custom", "format": "{#38;2;{{accent}}}── vessel {#38;2;{{brassDeep}}}──────────────────────────────" },
    { "type": "os",       "key": "  ◌ system",   "keyColor": "38;2;{{accent}}" },
    { "type": "host",     "key": "  ◌ hull",     "keyColor": "38;2;{{accent}}" },
    { "type": "kernel",   "key": "  ◌ kernel",   "keyColor": "38;2;{{accent}}" },
    { "type": "uptime",   "key": "  ◌ aloft",    "keyColor": "38;2;{{accent}}" },
    { "type": "packages", "key": "  ◌ cargo",    "keyColor": "38;2;{{accent}}" },
    { "type": "shell",    "key": "  ◌ shell",    "keyColor": "38;2;{{accent}}" },

    { "type": "custom", "format": "{#38;2;{{phosphor}}}── bridge {#38;2;{{phosphorDim}}}──────────────────────────────" },
    { "type": "wm",           "key": "  ◌ helm",     "keyColor": "38;2;{{phosphor}}" },
    { "type": "command",      "key": "  ◌ setup",    "keyColor": "38;2;{{phosphor}}",
      "text": "s=$(cat ~/.local/state/theme/setup 2>/dev/null); t=$(~/.config/theme/theme current 2>/dev/null); echo \"${s:-?} · ${t:-?}\"" },
    { "type": "font",         "key": "  ◌ type",     "keyColor": "38;2;{{phosphor}}" },
    { "type": "icons",        "key": "  ◌ icons",    "keyColor": "38;2;{{phosphor}}" },
    { "type": "cursor",       "key": "  ◌ cursor",   "keyColor": "38;2;{{phosphor}}" },
    { "type": "terminal",     "key": "  ◌ console",  "keyColor": "38;2;{{phosphor}}" },

    { "type": "custom", "format": "{#38;2;{{accent}}}── instruments {#38;2;{{brassDeep}}}─────────────────────────" },
    { "type": "cpu",     "key": "  ◌ cpu",       "keyColor": "38;2;{{accent}}" },
    { "type": "gpu",     "key": "  ◌ gpu",       "keyColor": "38;2;{{accent}}" },
    { "type": "memory",  "key": "  ◌ memory",    "keyColor": "38;2;{{accent}}" },
    { "type": "disk",    "key": "  ◌ hold",      "keyColor": "38;2;{{accent}}", "folders": "/" },
    { "type": "display", "key": "  ◌ optics",    "keyColor": "38;2;{{accent}}" },

    { "type": "custom", "format": "{#38;2;{{phosphor}}}── comms {#38;2;{{phosphorDim}}}───────────────────────────────" },
    { "type": "localip", "key": "  ◌ local",     "keyColor": "38;2;{{phosphor}}" },
    { "type": "command", "key": "  ◌ relay",     "keyColor": "38;2;{{phosphor}}",
      "text": "tailscale status --json 2>/dev/null | jq -r '[.Peer[]? | select(.Online)] | length as $n | if $n > 0 then \"tailscale · \\($n) stations online\" else \"tailscale · silent\" end' 2>/dev/null || echo 'no relay'" },

    { "type": "custom", "format": "{#38;2;{{accent}}}── sky {#38;2;{{brassDeep}}}─────────────────────────────────" },
    { "type": "command", "key": "  ◌ moon",      "keyColor": "38;2;{{accent}}",
      "text": "python3 -c \"import time,math; p=((time.time()-947182440)/86400/29.530588853)%1; n=['new moon','waxing crescent','first quarter','waxing gibbous','full moon','waning gibbous','last quarter','waning crescent'][round(p*8)%8]; print(n+'  ·  '+str(round((1-math.cos(2*math.pi*p))/2*100))+'% lit')\"" },

    "break",
    { "type": "colors", "symbol": "circle", "paddingLeft": 2 }
  ]
}
