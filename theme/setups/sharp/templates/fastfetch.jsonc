// Template for ~/.config/fastfetch/config.jsonc, rendered by ~/.config/theme/theme on every theme
// switch. Edit this file, not config.jsonc. {{role}} = the theme colour as "r;g;b"
// (accent, purple, dim, fg, green, warn, cyan, ...); {{logo_*}} = the theme's fastfetch image,
// sized to fit ~/.config/theme/settings.toml [fastfetch] at its own aspect ratio.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "kitty",
    "source": "{{logo_source}}",
    "width": {{logo_width}},
    "height": {{logo_height}},
    "padding": { "top": 1, "left": 2, "right": 4 }
  },
  "display": {
    "separator": "  ",
    "key": { "width": 16 },
    "color": {
      "separator": "38;2;{{dim}}",
      "output": "38;2;{{fg}}"
    }
  },
  "modules": [
    {
      "type": "title",
      "color": {
        "user": "38;2;{{purple}}",
        "at": "38;2;{{dim}}",
        "host": "38;2;{{accent}}"
      }
    },
    "break",

    { "type": "custom", "format": "{#38;2;{{accent}}}System {#38;2;{{dim}}}──────────────────────────" },
    { "type": "os",       "key": "├ 󰣇 OS",       "keyColor": "38;2;{{accent}}" },
    { "type": "host",     "key": "├ 󰌢 Host",     "keyColor": "38;2;{{accent}}" },
    { "type": "kernel",   "key": "├  Kernel",   "keyColor": "38;2;{{accent}}" },
    { "type": "uptime",   "key": "├ 󰅐 Uptime",   "keyColor": "38;2;{{accent}}" },
    { "type": "packages", "key": "├ 󰏖 Packages", "keyColor": "38;2;{{accent}}" },
    { "type": "shell",    "key": "└  Shell",    "keyColor": "38;2;{{accent}}" },

    { "type": "custom", "format": "{#38;2;{{purple}}}Desktop {#38;2;{{dim}}}─────────────────────────" },
    { "type": "de",           "key": "├ 󰧨 DE",        "keyColor": "38;2;{{purple}}" },
    { "type": "wm",           "key": "├  WM",        "keyColor": "38;2;{{purple}}" },
    { "type": "theme",        "key": "├ 󰉼 Theme",     "keyColor": "38;2;{{purple}}" },
    { "type": "icons",        "key": "├ 󰀻 Icons",     "keyColor": "38;2;{{purple}}" },
    { "type": "font",         "key": "├  Font",      "keyColor": "38;2;{{purple}}" },
    { "type": "cursor",       "key": "├ 󰇀 Cursor",    "keyColor": "38;2;{{purple}}" },
    { "type": "terminal",     "key": "├  Terminal",  "keyColor": "38;2;{{purple}}" },
    { "type": "terminalfont", "key": "└  Term Font", "keyColor": "38;2;{{purple}}" },

    { "type": "custom", "format": "{#38;2;{{green}}}Hardware {#38;2;{{dim}}}────────────────────────" },
    { "type": "cpu",     "key": "├  CPU",     "keyColor": "38;2;{{green}}" },
    { "type": "gpu",     "key": "├ 󰍛 GPU",     "keyColor": "38;2;{{green}}" },
    { "type": "memory",  "key": "├  Memory",  "keyColor": "38;2;{{green}}" },
    { "type": "swap",    "key": "├ 󰓡 Swap",    "keyColor": "38;2;{{green}}" },
    { "type": "disk",    "key": "├ 󰋊 Disk",    "keyColor": "38;2;{{green}}", "folders": "/" },
    { "type": "battery", "key": "├ 󰁹 Battery", "keyColor": "38;2;{{green}}" },
    { "type": "display", "key": "└ 󰍹 Display", "keyColor": "38;2;{{green}}" },

    { "type": "custom", "format": "{#38;2;{{warn}}}Network {#38;2;{{dim}}}─────────────────────────" },
    { "type": "localip", "key": "├ 󰩟 Local IP", "keyColor": "38;2;{{warn}}" },
    { "type": "locale",  "key": "└  Locale",   "keyColor": "38;2;{{warn}}" },

    { "type": "custom", "format": "{#38;2;{{cyan}}}Tailscale {#38;2;{{dim}}}───────────────────────" },
    { "type": "command", "key": "• 󰖂", "keyColor": "38;2;{{cyan}}",
      "text": "tailscale status --json 2>/dev/null | jq -r '([.Self] + [.Peer[]?]) | map(select(.Online)) | .[0] // empty | \"\\(.HostName)  \\(.TailscaleIPs[0])\"'" },
    { "type": "command", "key": "• 󰖂", "keyColor": "38;2;{{cyan}}",
      "text": "tailscale status --json 2>/dev/null | jq -r '([.Self] + [.Peer[]?]) | map(select(.Online)) | .[1] // empty | \"\\(.HostName)  \\(.TailscaleIPs[0])\"'" },
    { "type": "command", "key": "• 󰖂", "keyColor": "38;2;{{cyan}}",
      "text": "tailscale status --json 2>/dev/null | jq -r '([.Self] + [.Peer[]?]) | map(select(.Online)) | .[2] // empty | \"\\(.HostName)  \\(.TailscaleIPs[0])\"'" },
    { "type": "command", "key": "• 󰖂", "keyColor": "38;2;{{cyan}}",
      "text": "tailscale status --json 2>/dev/null | jq -r '([.Self] + [.Peer[]?]) | map(select(.Online)) | .[3] // empty | \"\\(.HostName)  \\(.TailscaleIPs[0])\"'" },
    { "type": "command", "key": "• 󰖂", "keyColor": "38;2;{{cyan}}",
      "text": "tailscale status --json 2>/dev/null | jq -r '([.Self] + [.Peer[]?]) | map(select(.Online)) | .[4] // empty | \"\\(.HostName)  \\(.TailscaleIPs[0])\"'" },

    "break",
    { "type": "colors", "symbol": "circle", "paddingLeft": 2 }
  ]
}
