#!/usr/bin/env python3
"""Setups hold everything; colour themes live inside a setup; the wallpaper follows the theme.

A setup is a whole desktop: its Quickshell, Walker theme, Hyprland look, kitty, hyprlock, cava,
fastfetch layout, fonts and cursor, plus its own colour themes. Nothing is shared between setups.

Setups:     ~/.config/theme/setups/<setup>/setup.toml         name, fonts, cursor, default theme, lock
            ~/.config/theme/setups/<setup>/themes/<id>.toml   that setup's colour themes
            ~/.config/theme/setups/<setup>/images/<id>/       Walker + fastfetch images per theme
            ~/.config/theme/setups/<setup>/templates/         fastfetch.jsonc
            ~/.config/theme/setups/<setup>/files/...          app configs, linked into ~/.config on a switch
                                                              (files/kitty/kitty.conf -> ~/.config/kitty/kitty.conf)
            ~/.config/quickshell/<setup>/                     its shell; ~/.config/quickshell/default -> it
            ~/.config/walker/themes/<setup>/                  its Walker theme; walker/themes/active -> it
Wallpapers: ~/Pictures/Wallpaper-Themes/_pool/                every wallpaper you own (drop new ones here)
            ~/Pictures/Wallpaper-Themes/<setup>/_all/         included in the setup, for any of its themes
            ~/Pictures/Wallpaper-Themes/<setup>/<id>/         assigned to one of the setup's themes
            (hardlinks of pool files, so they cost no space)

skwd-wall shows the active theme's wallpapers; a theme with none assigned shows everything in its setup.
Each setup remembers its last theme, each theme its last wallpaper.

  theme                      open the manager (TUI)
  theme pool                 open the TUI straight on the pool, to assign wallpapers
  theme setups               setups, * = active
  theme setup                active setup id
  theme setup <id>           switch setup: shell, launcher, look, fonts, its last theme + wallpaper
  theme list                 the active setup's themes, * = active
  theme current              active theme id
  theme set <id>             switch theme: colours, wallpapers, wallpaper
  theme next | prev          cycle themes
  theme reload               re-apply the active theme (after editing its file)
  theme sync                 rebuild ~/Pictures/Wallpapers for the active theme
  theme wall                 random wallpaper from the active theme
  theme edit [id]            edit a theme file in kitty + nvim, re-apply on exit
  theme image                show every theme's Walker + fastfetch images
  theme image <walker|fastfetch> <file|--clear> [id]
                             set (copy in) or clear a theme's image (default: the active theme)
  theme shell                (re)start the active setup's Quickshell
  theme lock                 lock the screen the active setup's way (hypridle's lock_cmd)
  theme openrgb              re-apply the OpenRGB colour only
"""

import json
import os
import random
import shutil
import subprocess
import sys
import tomllib

HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, HERE)
import writers  # noqa: E402

HOME = os.path.expanduser("~")
CONFIG = f"{HOME}/.config"
SETUPS = f"{HERE}/setups"
LIBRARY = f"{HOME}/Pictures/Wallpaper-Themes"
POOL = "_pool"
ALL = "_all"          # per-setup folder: in the setup, not tied to one theme
VIEW = f"{HOME}/Pictures/Wallpapers"
STATE = f"{HOME}/.local/state/theme/state.json"
THUMBS = f"{HOME}/.cache/theme/thumbs"
SKWD_LAST = f"{HOME}/.cache/skwd-wall-v2/last-wallpaper.json"
DEFAULT_SETUP = "sharp"

IMAGE_EXT = {".jpg", ".jpeg", ".png", ".webp", ".bmp", ".gif", ".avif", ".jxl", ".tif", ".tiff"}
VIDEO_EXT = {".mp4", ".webm", ".mkv", ".mov", ".avi"}

SETUP = None          # the setup being worked on (use()); normally the active one
THEMES = None         # SETUPS/<SETUP>/themes


# ---------------------------------------------------------------- setups

def setup_ids():
    try:
        return sorted(d for d in os.listdir(SETUPS) if os.path.isfile(f"{SETUPS}/{d}/setup.toml"))
    except OSError:
        return []


def load_setup(sid):
    with open(f"{SETUPS}/{sid}/setup.toml", "rb") as f:
        s = tomllib.load(f)
    s.setdefault("name", sid)
    s["id"] = sid
    s["dir"] = f"{SETUPS}/{sid}"
    return s


def active_setup():
    sid = load_state().get("setup")
    ids = setup_ids()
    return sid if sid in ids else DEFAULT_SETUP if DEFAULT_SETUP in ids else (ids or [DEFAULT_SETUP])[0]


def use(sid):
    """Point theme lookups, wallpaper folders and the writers at a setup."""
    global SETUP, THEMES
    SETUP = sid
    THEMES = f"{SETUPS}/{sid}/themes"
    writers.configure(load_setup(sid))


# ---------------------------------------------------------------- themes / state

def theme_ids():
    try:
        return sorted(f[:-5] for f in os.listdir(THEMES) if f.endswith(".toml"))
    except OSError:
        return []


def load_theme(tid):
    with open(f"{THEMES}/{tid}.toml", "rb") as f:
        t = tomllib.load(f)
    t.setdefault("name", tid)
    t["id"] = tid
    return t


def load_settings():
    try:
        with open(f"{HERE}/settings.toml", "rb") as f:
            return tomllib.load(f)
    except (OSError, tomllib.TOMLDecodeError):
        return {}


def cell_ratio(settings=None):
    """Terminal cell height/width: settings.toml override, else last measured in kitty, else 2.4."""
    settings = settings if settings is not None else load_settings()
    return float(settings.get("fastfetch", {}).get("cell_ratio") or load_state().get("cell_ratio") or 2.4)


def measure_cells():
    """When run in a terminal that reports pixel sizes, remember its cell shape for fastfetch."""
    try:
        import fcntl
        import struct
        import termios
        rows, cols, xp, yp = struct.unpack("HHHH", fcntl.ioctl(sys.stdout.fileno(), termios.TIOCGWINSZ,
                                                              b"\0" * 8))
    except (OSError, ImportError):
        return
    if not (rows and cols and xp and yp):
        return
    ratio = round((yp / rows) / (xp / cols), 3)
    state = load_state()
    if state.get("cell_ratio") != ratio:
        state["cell_ratio"] = ratio
        save_state(state)


def apply_colours(theme):
    settings = load_settings()
    writers.apply(theme, settings=settings, cell_ratio=cell_ratio(settings))


def load_state():
    try:
        with open(STATE) as f:
            state = json.load(f)
    except (OSError, ValueError):
        return {}
    if "current" in state and "setups" not in state:
        # From before setups: everything was Sharp
        state = {"setup": DEFAULT_SETUP, "cell_ratio": state.get("cell_ratio"),
                 "setups": {DEFAULT_SETUP: {"current": state["current"],
                                            "wallpapers": state.get("wallpapers", {})}}}
    return state


def save_state(state):
    writers.write(STATE, json.dumps(state, indent=2) + "\n")
    # The active setup on its own, for quick readers like ~/.config/theme/menu
    if state.get("setup"):
        writers.write(os.path.join(os.path.dirname(STATE), "setup"), state["setup"] + "\n")


def setup_state(state, sid=None):
    """The part of the state that belongs to one setup: {"current": theme, "wallpapers": {theme: rel}}."""
    return state.setdefault("setups", {}).setdefault(sid or SETUP, {})


def current():
    ids = theme_ids()
    tid = setup_state(load_state()).get("current")
    if tid in ids:
        return tid
    default = load_setup(SETUP).get("default_theme")
    return default if default in ids else (ids or [None])[0]


def notify(summary, body=""):
    writers.run("notify-send", "-a", "Theme", "-i", "preferences-desktop-theme", summary, body)


# ---------------------------------------------------------------- files

def is_media(name):
    return not name.startswith(".") and os.path.splitext(name)[1].lower() in IMAGE_EXT | VIDEO_EXT


def walk_files(root):
    """{relative path: absolute path} of media files under root (not following symlinked dirs)."""
    out = {}
    for dirpath, dirs, files in os.walk(root):
        dirs[:] = [d for d in dirs if not d.startswith(".")]
        for name in files:
            if is_media(name):
                path = os.path.join(dirpath, name)
                out[os.path.relpath(path, root)] = path
    return out


def folder(tid):
    """The pool, or <setup>/<theme> (and <setup>/_all) for the setup in use."""
    return os.path.join(LIBRARY, POOL) if tid == POOL else os.path.join(LIBRARY, SETUP, tid)


def theme_walls(tid):
    return walk_files(folder(tid))


def inode(path):
    st = os.stat(path)
    return st.st_dev, st.st_ino


def inodes_in(root):
    out = {}
    for path in walk_files(root).values():
        try:
            out[inode(path)] = path
        except OSError:
            pass
    return out


def free_path(path):
    """path, or path with -2, -3... before the extension if something is already there."""
    base, ext = os.path.splitext(path)
    n = 2
    while os.path.lexists(path):
        path = f"{base}-{n}{ext}"
        n += 1
    return path


def link(src, dst):
    """Hardlink (free, and skwd-wall sees a plain file); symlink if they're on different disks."""
    os.makedirs(os.path.dirname(dst), exist_ok=True)
    try:
        os.link(src, dst)
    except OSError:
        os.symlink(src, dst)


def same_file(a, b):
    try:
        return os.path.samefile(a, b)
    except OSError:
        return False


def tidy(root):
    for dirpath, dirs, files in os.walk(root, topdown=False):
        if dirpath != root and not os.listdir(dirpath):
            os.rmdir(dirpath)


# ---------------------------------------------------------------- the pool

def fill_pool():
    """Every wallpaper anywhere in the library or ~/Pictures/Wallpapers ends up in _pool. Returns count added."""
    pool = inodes_in(folder(POOL))
    added = 0
    for root in (LIBRARY, VIEW):
        for path in walk_files(root).values():
            if os.path.islink(path) or path.startswith(folder(POOL) + os.sep):
                continue
            key = inode(path)
            if key in pool:
                continue
            dst = free_path(os.path.join(folder(POOL), os.path.basename(path)))
            link(path, dst)
            pool[key] = dst
            added += 1
    return added


def pool_items():
    """Everything assignable: [{"key", "name", "path", "preview"}]; key = the file's name in the pool."""
    return [{"key": rel, "name": rel, "path": path, "preview": path}
            for rel, path in sorted(walk_files(folder(POOL)).items(), key=lambda x: x[0].lower())]


def memberships(ids=None):
    """{item key: set of theme ids (and ALL)} for everything assigned somewhere in the setup in use."""
    ids = (ids or theme_ids()) + [ALL]
    pool = {i: rel for i, rel in ((inode(p), r) for r, p in walk_files(folder(POOL)).items())}
    out = {}
    for tid in ids:
        for path in theme_walls(tid).values():
            try:
                rel = pool.get(inode(path))
            except OSError:
                continue
            if rel:
                out.setdefault(rel, set()).add(tid)
    return out


def assign(tid, item, on):
    """Put a pool item into / take it out of a theme (or ALL) of the setup in use."""
    pool_path = item["path"]
    here = [p for p in theme_walls(tid).values() if same_file(p, pool_path)]
    if on and not here:
        link(pool_path, free_path(os.path.join(folder(tid), os.path.basename(pool_path))))
    elif not on:
        for p in here:
            os.unlink(p)  # the pool keeps its copy
        tidy(folder(tid))


def view_walls(tid):
    """What skwd-wall shows for a theme: its own wallpapers, else everything in its setup."""
    own = theme_walls(tid)
    if own:
        return own
    out, seen = {}, set()
    for t in [ALL] + theme_ids():
        for rel, path in sorted(theme_walls(t).items()):
            try:
                key = inode(path)
            except OSError:
                continue
            if key in seen:
                continue
            seen.add(key)
            name = os.path.basename(rel)
            while name in out:
                base, ext = os.path.splitext(name)
                name = f"{base}-2{ext}"
            out[name] = path
    return out


# ---------------------------------------------------------------- what skwd-wall shows

def sync(tid):
    """Make ~/Pictures/Wallpapers exactly the theme's set. Returns (added, removed, pooled)."""
    os.makedirs(VIEW, exist_ok=True)
    pooled = fill_pool()  # strays in ~/Pictures/Wallpapers are safe in the pool before anything goes
    added = removed = 0

    wanted = view_walls(tid)
    for rel, path in walk_files(VIEW).items():
        if rel in wanted and same_file(path, wanted[rel]):
            continue
        if os.path.islink(path) and not os.path.realpath(path).startswith(LIBRARY + os.sep):
            continue  # someone else's symlink; leave it alone
        os.unlink(path)  # safe: fill_pool() just made sure the pool has it
        removed += 1
    for rel, src in wanted.items():
        dst = os.path.join(VIEW, rel)
        if not os.path.lexists(dst):
            link(src, dst)
            added += 1
    tidy(VIEW)

    return added, removed, pooled


def current_wallpaper_rel():
    try:
        with open(SKWD_LAST) as f:
            path = json.load(f).get("path", "")
    except (OSError, ValueError):
        return None
    if path.startswith(VIEW + os.sep):
        return os.path.relpath(path, VIEW)
    return None


def apply_wallpaper(path):
    if not shutil.which("skwd-helm"):
        return False
    try:
        return subprocess.run(["skwd-helm", "apply", path], stdout=subprocess.DEVNULL,
                              stderr=subprocess.DEVNULL, timeout=20).returncode == 0
    except (OSError, subprocess.SubprocessError):
        return False


def pick_wallpaper(tid, theme, state, avoid=None):
    view = walk_files(VIEW)
    for rel in (setup_state(state).get("wallpapers", {}).get(tid), theme.get("wallpaper")):
        if rel and rel in view and rel != avoid:
            return view[rel]
    if not view:
        return None
    stills = [p for r, p in view.items() if os.path.splitext(r)[1].lower() in IMAGE_EXT and r != avoid]
    pool = stills or [p for r, p in view.items() if r != avoid] or list(view.values())
    return random.choice(pool)


def remember_wallpaper(state):
    """Note the wallpaper the active theme is on, so coming back to it restores it."""
    sid = state.get("setup")
    old = setup_state(state, sid).get("current") if sid else None
    rel = current_wallpaper_rel()
    if old and rel:
        setup_state(state, sid).setdefault("wallpapers", {})[old] = rel


# ---------------------------------------------------------------- previews (for the TUI)

def thumbnail(item):
    """PNG thumbnail of a pool item for the kitty preview, cached; None if it can't be made."""
    src = item.get("preview")
    if not src or not os.path.exists(src):
        return None
    st = os.stat(src)
    out = f"{THUMBS}/{st.st_dev}-{st.st_ino}-{int(st.st_mtime)}.png"
    if os.path.exists(out):
        return out
    os.makedirs(THUMBS, exist_ok=True)
    frame = src + "[0]"
    if os.path.splitext(src)[1].lower() in VIDEO_EXT:
        if not shutil.which("ffmpeg"):
            return None
        frame = out + ".frame.png"
        subprocess.run(["ffmpeg", "-v", "quiet", "-y", "-ss", "1", "-i", src, "-frames:v", "1", frame])
    try:
        ok = subprocess.run(["magick", frame, "-thumbnail", "640x400>", out], stdout=subprocess.DEVNULL,
                            stderr=subprocess.DEVNULL, timeout=60).returncode == 0
    except (OSError, subprocess.SubprocessError):
        ok = False
    if frame.endswith(".frame.png") and os.path.exists(frame):
        os.unlink(frame)
    return out if ok and os.path.exists(out) else None


# ---------------------------------------------------------------- setup plumbing

def setup_files(sid):
    """{target under ~/.config: source file} for everything in setups/<sid>/files/."""
    root = f"{SETUPS}/{sid}/files"
    out = {}
    for dirpath, _, files in os.walk(root):
        for name in files:
            src = os.path.join(dirpath, name)
            out[os.path.join(CONFIG, os.path.relpath(src, root))] = src
    return out


def point(link_path, target):
    """Make link_path a symlink to target (relative), replacing an old symlink atomically."""
    os.makedirs(os.path.dirname(link_path), exist_ok=True)
    rel = os.path.relpath(target, os.path.dirname(link_path))
    tmp = link_path + ".tmp-link"
    if os.path.lexists(tmp):
        os.unlink(tmp)
    os.symlink(rel, tmp)
    os.replace(tmp, link_path)


def link_setup(sid, old=None):
    """Link the setup's files into ~/.config and point the Quickshell / Walker pointers at it.

    A real file where a link should go is kept as <file>.pre-setup; links the old setup owned that
    the new one doesn't have are removed.
    """
    new = setup_files(sid)
    if old and old != sid:
        for target in setup_files(old):
            if target not in new and os.path.islink(target) and \
                    os.path.realpath(target).startswith(SETUPS + os.sep):
                os.unlink(target)
    for target, src in new.items():
        if os.path.lexists(target) and not os.path.islink(target):
            os.replace(target, free_path(target + ".pre-setup"))
        point(target, src)
    if os.path.isfile(f"{CONFIG}/quickshell/{sid}/shell.qml"):
        point(f"{CONFIG}/quickshell/default", f"{CONFIG}/quickshell/{sid}")
    if os.path.isdir(f"{CONFIG}/walker/themes/{sid}"):
        point(f"{CONFIG}/walker/themes/active", f"{CONFIG}/walker/themes/{sid}")


def shell_running():
    out = subprocess.run(["qs", "list", "-c", "default"], capture_output=True, text=True).stdout
    return "Instance" in out


def restart_shell():
    """Quickshell for the active setup (~/.config/quickshell/default). The old one goes first:
    only one process can own notifications and the tray. (Only that instance: the switch transition
    is a Quickshell too.)"""
    writers.run("qs", "kill", "-c", "default")
    for _ in range(30):
        if not shell_running():
            break
        subprocess.run(["sleep", "0.1"])
    # Started by Hyprland, so it lands in the login session's cgroup: polkit only accepts an
    # authentication agent (the setup's password prompt) from a process in the session
    ok = subprocess.run(["hyprctl", "dispatch", 'hl.dsp.exec_cmd("qs")'], capture_output=True, text=True,
                        timeout=5).stdout.strip() == "ok" if shutil.which("hyprctl") else False
    if not ok:
        subprocess.Popen(["qs"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)


# ---------------------------------------------------------------- the switch transition

TRANSITION = f"{HERE}/transition"                # the overlay (a small Quickshell config)
TRANSITION_DIR = f"{os.environ.get('XDG_RUNTIME_DIR', '/tmp')}/theme-transition"


class Transition:
    """Hides a switch behind a snapshot of the screens, then reveals the result in the target setup's
    style (setup.toml [transition] style = fade | wipe | iris | dissolve, duration = ms). Reentrant: a theme
    switch inside a setup switch shares the setup's transition. Anything going wrong just means no
    transition, never a failed switch. settings.toml [transition] enabled = false turns it off."""
    depth = 0

    def __init__(self, sid, tid=None, new_shell=False):
        self.sid, self.tid, self.new_shell = sid, tid, new_shell
        self.proc = None

    def __enter__(self):
        Transition.depth += 1
        if Transition.depth > 1 or not self.wanted():
            return self
        try:
            self.start()
        except Exception:        # noqa: BLE001 - a transition must never stop a switch
            self.stop()
        return self

    def wanted(self):
        return (load_settings().get("transition", {}).get("enabled", True) and os.environ.get("WAYLAND_DISPLAY")
                and shutil.which("grim") and shutil.which("qs") and os.path.isfile(f"{TRANSITION}/shell.qml"))

    def start(self):
        setup = load_setup(self.sid)
        conf = setup.get("transition", {})
        accent = "#ffffff"
        try:
            with open(f"{SETUPS}/{self.sid}/themes/{self.tid}.toml", "rb") as f:
                accent = tomllib.load(f)["palette"]["accent"]
        except (OSError, KeyError, tomllib.TOMLDecodeError):
            pass
        os.makedirs(TRANSITION_DIR, exist_ok=True)
        for name in os.listdir(TRANSITION_DIR):
            os.unlink(f"{TRANSITION_DIR}/{name}")
        monitors = json.loads(subprocess.run(["hyprctl", "monitors", "-j"], capture_output=True,
                                             text=True, timeout=3).stdout or "[]")
        if not monitors or not all(m.get("dpmsStatus", True) for m in monitors):
            return                                 # screens off: nothing to see, and grim would wait forever
        grabs = [subprocess.Popen(["grim", "-t", "ppm", "-o", m["name"], f"{TRANSITION_DIR}/{m['name']}.ppm"])
                 for m in monitors]
        try:
            for g in grabs:
                g.wait(timeout=2)
        except subprocess.TimeoutExpired:
            for g in grabs:
                g.kill()
            raise
        with open(f"{TRANSITION_DIR}/params.json", "w") as f:
            json.dump({"style": conf.get("style", "fade"), "accent": accent,
                       "duration": int(conf.get("duration", 700))}, f)
        self.proc = subprocess.Popen(["qs", "-p", TRANSITION], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                                     start_new_session=True)
        for _ in range(40):                        # up to 2 s for the covers to be on screen
            if os.path.exists(f"{TRANSITION_DIR}/ready"):
                return
            subprocess.run(["sleep", "0.05"])
        self.stop()

    def stop(self):
        if self.proc and self.proc.poll() is None:
            self.proc.kill()
        self.proc = None

    def __exit__(self, *exc):
        Transition.depth -= 1
        if Transition.depth > 0 or not self.proc:
            return False
        if self.new_shell:                         # wait for the new shell to answer, up to 4 s
            for _ in range(40):
                r = subprocess.run(["qs", "ipc", "-c", "default", "show"], capture_output=True, text=True)
                if "target" in r.stdout:
                    break
                subprocess.run(["sleep", "0.1"])
            subprocess.run(["sleep", "0.35"])      # its first frames
        else:
            subprocess.run(["sleep", "0.15"])
        subprocess.Popen(["qs", "ipc", "-p", TRANSITION, "call", "transition", "go"],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
        return False


# ---------------------------------------------------------------- commands

def cmd_set(tid, quiet=False):
    if tid not in theme_ids():
        sys.exit(f"no theme '{tid}' in {SETUP} (have: {', '.join(theme_ids())})")
    with Transition(SETUP, tid):
        return _set(tid, quiet)


def _set(tid, quiet):
    theme = load_theme(tid)
    state = load_state()
    remember_wallpaper(state)

    added, removed, pooled = sync(tid)
    state["setup"] = SETUP
    setup_state(state)["current"] = tid
    save_state(state)

    apply_colours(theme)

    wall = pick_wallpaper(tid, theme, state)
    if wall:
        apply_wallpaper(wall)
    if not quiet:
        n = len(walk_files(VIEW))
        notify(f"Theme: {theme['name']}",
               f"{n} wallpaper{'s' * (n != 1)}" + ("" if n else " — assign some with Style → Wallpaper → Assign wallpapers"))
    return pooled


def cmd_setup(sid, quiet=False):
    if sid not in setup_ids():
        sys.exit(f"no setup '{sid}' (have: {', '.join(setup_ids())})")
    state = load_state()
    old = state.get("setup")
    remember_wallpaper(state)
    save_state(state)

    use(sid)
    tid = current()
    if not tid:
        sys.exit(f"setup '{sid}' has no themes in {THEMES}")
    with Transition(sid, tid, new_shell=True):
        link_setup(sid, old)
        pooled = cmd_set(tid, quiet=True)   # colours, fonts, cursor, wallpapers, Walker restart
        writers.run("hyprctl", "reload")    # the new look.lua (colors.lua is already written)
        restart_shell()
    if not quiet:
        setup = load_setup(sid)
        notify(f"Setup: {setup['name']}", f"theme {load_theme(tid)['name']}")
    return pooled


def cmd_setups():
    cur = active_setup()
    for sid in setup_ids():
        s = load_setup(sid)
        use(sid)
        print(f"{'*' if sid == cur else ' '} {sid:<16} {s['name']:<16} {len(theme_ids()):>2} themes"
              f"   last theme: {current()}")


def cmd_list():
    cur = current()
    for tid in theme_ids():
        t = load_theme(tid)
        print(f"{'*' if tid == cur else ' '} {tid:<20} {t['name']:<20} {len(theme_walls(tid)):>3} wallpapers")
    print(f"  {'(setup)':<20} {'any theme':<20} {len(theme_walls(ALL)):>3} wallpapers")
    print(f"  {'(pool)':<20} {'everything':<20} {len(theme_walls(POOL)):>3} wallpapers")


def cmd_cycle(step):
    ids = theme_ids()
    cur = current()
    i = ids.index(cur) if cur in ids else 0
    cmd_set(ids[(i + step) % len(ids)])


def cmd_reload():
    apply_colours(load_theme(current()))


def cmd_image(args):
    if not args:
        for tid in theme_ids():
            row = []
            for kind in writers.IMAGE_KINDS:
                path, default = writers.theme_image(tid, kind)
                row.append(f"{kind}: " + ("(default)" if default else os.path.basename(path)))
            print(f"{tid:<20} " + "   ".join(row))
        return
    kind = args[0]
    if kind not in writers.IMAGE_KINDS or len(args) < 2:
        sys.exit("usage: theme image <walker|fastfetch> <file|--clear> [theme]")
    tid = args[2] if len(args) > 2 else current()
    if tid not in theme_ids():
        sys.exit(f"no theme '{tid}'")
    set_image(tid, kind, None if args[1] == "--clear" else args[1])
    print(f"{tid} {kind}: {writers.theme_image(tid, kind)[0]}")


def set_image(tid, kind, src):
    """Copy src in as the theme's <kind> image (None = back to the default); re-apply if active."""
    folder_ = f"{writers.IMAGES}/{tid}"
    if src:
        src = os.path.abspath(os.path.expanduser(src))
        if not os.path.isfile(src):
            sys.exit(f"no such file: {src}")
    os.makedirs(folder_, exist_ok=True)
    for name in os.listdir(folder_):
        if os.path.splitext(name)[0] == kind:
            os.unlink(os.path.join(folder_, name))
    if src:
        shutil.copyfile(src, os.path.join(folder_, kind + os.path.splitext(src)[1].lower()))
    if tid == current() and SETUP == active_setup():
        cmd_reload()


def cmd_wall():
    tid = current()
    path = pick_wallpaper(tid, {}, {}, avoid=current_wallpaper_rel())
    if not path:
        notify("No wallpapers in this theme", "Assign some with Style → Wallpaper → Assign wallpapers")
        return
    apply_wallpaper(path)


def cmd_edit(tid=None):
    tid = tid or current()
    path = f"{THEMES}/{tid}.toml"
    me = os.path.realpath(__file__)
    reapply = f"'{me}' reload" if tid == current() else "true"
    subprocess.Popen(["kitty", "--class", "theme-edit", "-e", "sh", "-c", f"nvim '{path}' && {reapply}"],
                     start_new_session=True)


def cmd_rows(what):
    """Tab-separated rows for the Walker menus (elephant/menus/themes.lua, setups.lua)."""
    if what == "themes":
        cur = current()
        for tid in theme_ids():
            t = load_theme(tid)
            print("\t".join([tid, t["name"], t.get("palette", {}).get("accent", ""),
                             str(len(theme_walls(tid))), "1" if tid == cur else "0"]))
    elif what == "setups":
        cur = active_setup()
        for sid in setup_ids():
            s = load_setup(sid)
            use(sid)
            print("\t".join([sid, s["name"], s.get("description", ""), str(len(theme_ids())),
                             load_theme(current())["name"] if current() else "", "1" if sid == cur else "0"]))


def cmd_lock():
    cmd = load_setup(SETUP).get("lock", "pidof hyprlock || hyprlock")
    os.execvp("sh", ["sh", "-c", cmd])


def main():
    measure_cells()
    use(active_setup())
    args = sys.argv[1:]
    cmd = args[0] if args else "tui"
    if cmd in ("-h", "--help", "help"):
        print(__doc__)
    elif cmd == "setups":
        cmd_setups()
    elif cmd == "setup" and len(args) == 1:
        print(SETUP)
    elif cmd == "setup" and len(args) == 2:
        cmd_setup(args[1])
    elif cmd == "list":
        cmd_list()
    elif cmd == "current":
        print(current())
    elif cmd == "set" and len(args) == 2:
        cmd_set(args[1])
    elif cmd == "next":
        cmd_cycle(1)
    elif cmd == "prev":
        cmd_cycle(-1)
    elif cmd == "reload":
        cmd_reload()
    elif cmd == "sync":
        print("added %d, removed %d, pooled %d" % sync(current()))
    elif cmd == "wall":
        cmd_wall()
    elif cmd == "edit":
        cmd_edit(args[1] if len(args) > 1 else None)
    elif cmd == "image":
        cmd_image(args[1:])
    elif cmd == "shell":
        restart_shell()
    elif cmd == "lock":
        cmd_lock()
    elif cmd == "rows" and len(args) == 2:
        cmd_rows(args[1])
    elif cmd == "openrgb":
        writers.apply_openrgb_only(load_theme(current()))
    elif cmd in ("tui", "pool"):
        import tui
        tui.run(sys.modules[__name__], start_in_pool=cmd == "pool")
    else:
        print(__doc__)
        sys.exit(2)


if __name__ == "__main__":
    main()
