// Generated from the Deep Field theme by ~/.config/theme/theme; edit ~/.config/theme/setups/observatory/templates/fastfetch.jsonc
// Observatory: an observatory log. Vessel, bridge, instruments, comms, and tonight's sky.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "kitty",
    "source": "/home/av/.cache/theme/fastfetch/deep-field-455271-1790485263-2067x2480.png",
    "width": 65,
    "height": 30,
    "padding": { "top": 1, "left": 2, "right": 4 }
  },
  "display": {
    "separator": "  ",
    "key": { "width": 15 },
    "color": {
      "separator": "38;2;93;102;121",
      "output": "38;2;216;210;194"
    }
  },
  "modules": [
    { "type": "custom", "format": "{#38;2;236;208;146}◈  O B S E R V A T O R Y   L O G" },
    {
      "type": "command",
      "key": "   stardate",
      "keyColor": "38;2;93;102;121",
      "text": "printf '%s.%03d  ·  %s@%s' \"$(date +%Y)\" \"$(date +%j)\" \"$USER\" \"$(cat /etc/hostname 2>/dev/null || uname -n)\""
    },
    "break",

    { "type": "custom", "format": "{#38;2;201;164;92}── vessel {#38;2;122;98;55}──────────────────────────────" },
    { "type": "os",       "key": "  ◌ system",   "keyColor": "38;2;201;164;92" },
    { "type": "host",     "key": "  ◌ hull",     "keyColor": "38;2;201;164;92" },
    { "type": "kernel",   "key": "  ◌ kernel",   "keyColor": "38;2;201;164;92" },
    { "type": "uptime",   "key": "  ◌ aloft",    "keyColor": "38;2;201;164;92" },
    { "type": "packages", "key": "  ◌ cargo",    "keyColor": "38;2;201;164;92" },
    { "type": "shell",    "key": "  ◌ shell",    "keyColor": "38;2;201;164;92" },

    { "type": "custom", "format": "{#38;2;111;214;208}── bridge {#38;2;44;93;91}──────────────────────────────" },
    { "type": "wm",           "key": "  ◌ helm",     "keyColor": "38;2;111;214;208" },
    { "type": "command",      "key": "  ◌ setup",    "keyColor": "38;2;111;214;208",
      "text": "s=$(cat ~/.local/state/theme/setup 2>/dev/null); t=$(~/.config/theme/theme current 2>/dev/null); echo \"${s:-?} · ${t:-?}\"" },
    { "type": "font",         "key": "  ◌ type",     "keyColor": "38;2;111;214;208" },
    { "type": "icons",        "key": "  ◌ icons",    "keyColor": "38;2;111;214;208" },
    { "type": "cursor",       "key": "  ◌ cursor",   "keyColor": "38;2;111;214;208" },
    { "type": "terminal",     "key": "  ◌ console",  "keyColor": "38;2;111;214;208" },

    { "type": "custom", "format": "{#38;2;201;164;92}── instruments {#38;2;122;98;55}─────────────────────────" },
    { "type": "cpu",     "key": "  ◌ cpu",       "keyColor": "38;2;201;164;92" },
    { "type": "gpu",     "key": "  ◌ gpu",       "keyColor": "38;2;201;164;92" },
    { "type": "memory",  "key": "  ◌ memory",    "keyColor": "38;2;201;164;92" },
    { "type": "disk",    "key": "  ◌ hold",      "keyColor": "38;2;201;164;92", "folders": "/" },
    { "type": "display", "key": "  ◌ optics",    "keyColor": "38;2;201;164;92" },

    { "type": "custom", "format": "{#38;2;111;214;208}── comms {#38;2;44;93;91}───────────────────────────────" },
    { "type": "localip", "key": "  ◌ local",     "keyColor": "38;2;111;214;208" },
    { "type": "command", "key": "  ◌ relay",     "keyColor": "38;2;111;214;208",
      "text": "tailscale status --json 2>/dev/null | jq -r '[.Peer[]? | select(.Online)] | length as $n | if $n > 0 then \"tailscale · \\($n) stations online\" else \"tailscale · silent\" end' 2>/dev/null || echo 'no relay'" },

    { "type": "custom", "format": "{#38;2;201;164;92}── sky {#38;2;122;98;55}─────────────────────────────────" },
    { "type": "command", "key": "  ◌ moon",      "keyColor": "38;2;201;164;92",
      "text": "python3 -c \"import time,math; p=((time.time()-947182440)/86400/29.530588853)%1; n=['new moon','waxing crescent','first quarter','waxing gibbous','full moon','waning gibbous','last quarter','waning crescent'][round(p*8)%8]; print(n+'  ·  '+str(round((1-math.cos(2*math.pi*p))/2*100))+'% lit')\"" },

    "break",
    { "type": "colors", "symbol": "circle", "paddingLeft": 2 }
  ]
}
