# Rice configs only: everything is ignored unless listed below
/*
!/.gitignore
!/README.md
!/brave-flags.conf
!/chromium-flags.conf
!/theme/
!/quickshell/
!/walker/
!/elephant/
!/hypr/
!/kitty/
!/cava/
!/fastfetch/
!/fontconfig/
!/gtk-3.0/
!/gtk-4.0/
!/qt6ct/
!/satty/
!/btop/
!/skwd-wall-v2/
!/voxtype/
!/starship.toml
*.bak*
__pycache__/
/theme/images/
/fastfetch/*.png
/fastfetch/*.jpg
/btop/themes/
/nvim/
# Written by ~/.config/theme/theme on every theme switch
/quickshell/*/colors.json
/walker/themes/*/colors.css
/kitty/skwd-colors.conf
/hypr/colors.lua
/hypr/hyprlock-colors.conf
/fastfetch/config.jsonc
/theme/setups/*/images/
*.tmp-link

# Holds the Wallhaven API key: never commit
/skwd-wall-v2/config.json
