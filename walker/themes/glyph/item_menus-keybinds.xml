<?xml version="1.0" encoding="UTF-8"?>
<!-- Keybind cheat sheet row:  [ SUPER + Q ]  Terminal  (one line, omarchy-style) -->
<interface>
  <requires lib="gtk" version="4.0"></requires>
  <object class="GtkBox" id="ItemBox">
    <style>
      <class name="item-box"></class>
      <class name="kb-row"></class>
    </style>
    <property name="orientation">horizontal</property>
    <property name="spacing">14</property>
    <child>
      <object class="GtkLabel" id="ItemSubtext">
        <style>
          <class name="kb-keys"></class>
        </style>
        <property name="width-chars">22</property>
        <property name="max-width-chars">22</property>
        <property name="xalign">0</property>
        <property name="ellipsize">end</property>
      </object>
    </child>
    <child>
      <object class="GtkLabel" id="ItemText">
        <style>
          <class name="item-text"></class>
          <class name="kb-desc"></class>
        </style>
        <property name="hexpand">true</property>
        <property name="xalign">0</property>
        <property name="ellipsize">end</property>
      </object>
    </child>
  </object>
</interface>
